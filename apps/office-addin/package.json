    "test": "node ../../scripts/build-wasm.mjs && vitest run"
  },
  "dependencies": {
    "@azure/msal-browser": "5.25.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lineage/design": "workspace:*",
    "@lineage/shell": "workspace:*",
    "@lineage/storage-local": "workspace:*",
    "@lineage/storage-onedrive": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/office-js": "1.0.611",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2"
  }
}
