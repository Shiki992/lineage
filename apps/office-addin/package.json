{
  "name": "@lineage/office-addin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The Lineage task pane for Word: React, 360 px, running the engine as wasm.",
  "scripts": {
    "dev": "node ../../scripts/build-wasm.mjs && vite",
    "build": "node ../../scripts/build-wasm.mjs && vite build",
