# Copy to .env.local (git-ignored) and fill in. See docs/setup/microsoft-app-registration.md.

# The Application (client) ID of your own Microsoft Entra app registration.
VITE_LINEAGE_CLIENT_ID=

# Where My documents (apps/family-app) is served, for the footer link. Development
# builds use http://localhost:3001/ when this is empty; production builds hide the link.
VITE_LINEAGE_APP_URL=

# Development only: "dev-folder" (default) keeps history in apps/office-addin/.dev-storage;
# "onedrive" signs in and uses your OneDrive.
VITE_LINEAGE_STORAGE=dev-folder

# Development only, with VITE_LINEAGE_STORAGE=onedrive: "appFolder" (default) or "nextToMaster"
# (BLUEPRINT open decision 1; needs Files.ReadWrite).
VITE_LINEAGE_LAYOUT=appFolder

# Testing only (dev builds): skip the 4 MB check before writing into the open document.
# VITE_LINEAGE_LIFT_SIZE_LIMIT=1
