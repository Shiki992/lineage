# Copy to .env.local (git-ignored) and fill in. See docs/setup/microsoft-app-registration.md.

# The same Application (client) ID as the Word add-in: both must see the same
# Apps/Lineage folder in OneDrive.
VITE_LINEAGE_CLIENT_ID=

# Development only: "dev-folder" (default) reads apps/office-addin/.dev-storage
# (or LINEAGE_DEV_STORAGE); "onedrive" signs in and reads your OneDrive.
VITE_LINEAGE_STORAGE=dev-folder
