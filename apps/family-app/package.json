{
  "name": "@lineage/family-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "My documents: a static web app showing every tracked family, its versions, sent copies and family tree, read from the person's own storage.",
  "scripts": {
    "dev": "node ../../scripts/build-wasm.mjs && vite",
    "build": "node ../../scripts/build-wasm.mjs && vite build",
    "typecheck": "node ../../scripts/build-wasm.mjs && tsc --noEmit",
    "test": "node ../../scripts/build-wasm.mjs && vitest run",
    "e2e": "node ../../scripts/build-wasm.mjs && playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "5.25.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lineage/design": "workspace:*",
    "@lineage/shell": "workspace:*",
    "@lineage/storage-local": "workspace:*",
    "@lineage/storage-onedrive": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "valibot": "1.5.0"
  }
}
